# Copy to .env (never commit it).

# Notion internal integration secret: https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Filled in by scripts/setup_notion.py
NOTION_DATA_SOURCE=

# agy model for form answers and founder scans (any model your agy accepts)
QF_MODEL=gemini-3.8-flash-low

# Where agy lives, if it isn't on PATH
# AGY_BIN=/Users/you/.local/bin/agy
